rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────────
    // Owner-only: recruiters/admins access candidate profiles through the
    // backend API (Admin SDK), which bypasses client-side security rules.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Resumes ───────────────────────────────────────────────────────────────
    // Owner-only: same rationale as users above.
    match /resumes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Resume drafts ─────────────────────────────────────────────────────────
    match /resumeDrafts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Interviews ────────────────────────────────────────────────────────────
    // Only the candidate who owns the session can read or write their results.
    match /interviews/{interviewId} {
      allow read: if request.auth != null
        && resource.data.candidateId == request.auth.uid;
      allow write: if request.auth != null
        && (resource == null || resource.data.candidateId == request.auth.uid)
        && (request.resource == null || request.resource.data.candidateId == request.auth.uid);
    }

    // ── API keys wallet ───────────────────────────────────────────────────────
    // Read-only for owner; writes only via backend Admin SDK.
    match /apiKeysWallet/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Jobs ──────────────────────────────────────────────────────────────────
    // Any authenticated user can browse jobs; writes are backend-only.
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Applications ──────────────────────────────────────────────────────────
    // Candidates can only read their own applications; writes via backend only.
    match /applications/{appId} {
      allow read: if request.auth != null
        && resource.data.candidateId == request.auth.uid;
      allow write: if false;
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    // Only sender or recipient can read a message; writes via backend only.
    match /messages/{msgId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || resource.data.recipientId == request.auth.uid);
      allow write: if false;
    }

    // ── Smart Apply — scraped job pool ────────────────────────────────────────
    // Shared read-only pool for all authenticated users.
    match /scraped_jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Apply sessions ────────────────────────────────────────────────────────
    // Each user's own queue — strictly owner-only.
    match /apply_sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    // Only participants listed in the chat document can read/write.
    // participantIds is an array of UIDs written by the backend at chat creation.
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && resource.data.participantIds.hasAny([request.auth.uid]);
      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId))
               .data.participantIds.hasAny([request.auth.uid]);
      }
    }

    // ── Email OTP store ───────────────────────────────────────────────────────
    // Backend-write only; no client reads allowed.
    match /email_otps/{docId} {
      allow read, write: if false;
    }

    // ── Everything else — deny ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
