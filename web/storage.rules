rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of the folder path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has a recruiter role
    // Storage rules do not support direct firestore gets natively without special setup,
    // so we rely on custom auth claims or standard authenticated checks for viewing.
    function isAuthorizedReader() {
      return isAuthenticated();
    }

    // Match files inside user folders (profile pictures, elevator pitches)
    match /users/{userId}/{allPaths=**} {
      // Authenticated users can view candidate pictures and pitches
      allow read: if isAuthorizedReader();
      // Only the folder owner can upload, update or delete their media files
      allow write: if isOwner(userId);
    }

    // Company logos — recruiter uploads on job post; candidates read publicly.
    match /company-logos/{userId}/{allPaths=**} {
      allow read:  if true;           // logos are public
      allow write: if isOwner(userId);
    }

    // Identity-check media is intentionally not stored in Firebase Storage.
    // If a future feature needs retained interview media, expose it only through
    // a reviewed backend endpoint with an explicit retention policy.
    match /interviews/{userId}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
