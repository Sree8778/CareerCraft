# ── Copy this file to .env.cloud and fill in your values ─────────────────────
# .env.cloud is git-ignored — never commit it.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=recruit-edge-e0d1b
GCP_REGION=us-central1

# ── AI (Google AI Studio → https://aistudio.google.com/app/apikey) ───────────
GEMINI_API_KEY=your-gemini-api-key

# ── Backend vault encryption key ──────────────────────────────────────────────
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change this after users have stored API keys — all stored keys would become unreadable.
BACKEND_VAULT_MASTER_KEY=1GBRIUdAmmhRGCVlOBv40AwPifnQfsPb5XKFfR-zpL8=

# ── Super Admin emails ────────────────────────────────────────────────────────
# Comma-separated list of email addresses that have admin access.
# REQUIRED: if this is not set, ALL admin endpoints will return 403.
# Example: SUPER_ADMIN_EMAILS=you@example.com,cofounder@example.com
SUPER_ADMIN_EMAILS=your-admin@example.com

# ── CORS allowed origins ──────────────────────────────────────────────────────
# Comma-separated list of frontend and extension origins that may call the API.
# In development the backend defaults to http://localhost:3000,http://localhost:5173
# Example: ALLOWED_ORIGINS=https://careercraft.example.com,chrome-extension://abcdefghijk
ALLOWED_ORIGINS=https://your-frontend.run.app

# ── Firebase client config (Firebase Console → Project Settings → Your apps) ─
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBhM8zrjFa_7F-m4HBy7coP9Vt1Qz_zOLQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=recruit-edge-e0d1b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=recruit-edge-e0d1b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=recruit-edge-e0d1b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=414523842687
NEXT_PUBLIC_FIREBASE_APP_ID=1:414523842687:web:cb968d18d533619efadf4a
